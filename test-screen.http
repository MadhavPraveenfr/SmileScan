### ============================================
### 1. Health Check — Supabase + Agnes
### ============================================

GET http://127.0.0.1:3000/api/health


### ============================================
### 2. Screening Pipeline — analyze 5 photos
### ============================================
### First run: CACHE MISS x5, ~30s
### Second run: CACHE HIT x5, ~2s

POST http://127.0.0.1:3000/api/screen
Content-Type: multipart/form-data; boundary=----BoundaryXYZ

------BoundaryXYZ
Content-Disposition: form-data; name="front-smile"; filename="front-smile.jpg"
Content-Type: image/jpeg

< E:/Drishti/test-images/front-smile.jpg
------BoundaryXYZ
Content-Disposition: form-data; name="upper-arch"; filename="upper-arch.jpg"
Content-Type: image/jpeg

< E:/Drishti/test-images/upper-arch.jpg
------BoundaryXYZ
Content-Disposition: form-data; name="lower-arch"; filename="lower-arch.jpg"
Content-Type: image/jpeg

< E:/Drishti/test-images/lower-arch.jpg
------BoundaryXYZ
Content-Disposition: form-data; name="left-bite"; filename="left-bite.jpg"
Content-Type: image/jpeg

< E:/Drishti/test-images/left-bite.jpg
------BoundaryXYZ
Content-Disposition: form-data; name="right-bite"; filename="right-bite.jpg"
Content-Type: image/jpeg

< E:/Drishti/test-images/right-bite.jpg
------BoundaryXYZ
Content-Disposition: form-data; name="email"

test@example.com
------BoundaryXYZ--


### ============================================
### 3. Fetch Report by Assessment ID
### ============================================
### Uses a real UUID from previous runs

GET http://127.0.0.1:3000/api/report/0dd46b91-d664-4195-95ce-a8f91d48ccd3


### ============================================
### 4. Fetch Report — Not Found (expect 404)
### ============================================

GET http://127.0.0.1:3000/api/report/00000000-0000-0000-0000-000000000000


### ============================================
### 5. Fetch Report — Malformed ID (expect 400)
### ============================================

GET http://127.0.0.1:3000/api/report/not-a-uuid


### ============================================
### 6. Booking — Success (expect 200)
### ============================================

POST http://127.0.0.1:3000/api/book
Content-Type: application/json

{
  "assessmentId": "0dd46b91-d664-4195-95ce-a8f91d48ccd3",
  "name": "Priya Sharma",
  "phone": "+91 9876543210",
  "email": "priya@example.com",
  "preferredClinic": "Carestack Dental - Koramangala",
  "notes": "Free on weekday evenings"
}


### ============================================
### 7. Booking — Missing Phone (expect 400)
### ============================================

POST http://127.0.0.1:3000/api/book
Content-Type: application/json

{
  "assessmentId": "0dd46b91-d664-4195-95ce-a8f91d48ccd3",
  "name": "Test Patient"
}


### ============================================
### 8. Booking — Malformed ID (expect 400)
### ============================================

POST http://127.0.0.1:3000/api/book
Content-Type: application/json

{
  "assessmentId": "not-a-uuid",
  "name": "Test Patient",
  "phone": "9876543210"
}


### ============================================
### 9. Booking — Nonexistent Assessment (expect 404)
### ============================================

POST http://127.0.0.1:3000/api/book
Content-Type: application/json

{
  "assessmentId": "00000000-0000-0000-0000-000000000000",
  "name": "Test Patient",
  "phone": "9876543210"
}


